  });

  it("the read-model source path imports NO email/notification send path (Epic 13 owns reminders)", () => {
    expect(existsSync(READ_MODELS_DIR)).toBe(true);
    const files = readdirSync(READ_MODELS_DIR).filter((f) => f.endsWith(".ts"));
